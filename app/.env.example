# Hyperledger Fabric connection configuration for the ICN project.
# Copy this file to .env before first use: cp app/.env.example app/.env
#
# After running `docker compose up` from the project root, the certs in
# ../fabric/creds/ are populated automatically. No manual steps needed.

# ── Peer connection ─────────────────────────────────────────────────────────
# Host (peer exposed on localhost via docker-compose port mapping):
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOSTNAME_OVERRIDE=peer0.org1.example.com

# If running the Python client inside the same Docker network (future):
# FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051

# ── Channel and chaincode ───────────────────────────────────────────────────
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=icnledger

# ── MSP identity ────────────────────────────────────────────────────────────
FABRIC_MSP_ID=Org1MSP

# ── Certificate paths ───────────────────────────────────────────────────────
# Generated by `docker compose up` (fabric/network/scripts/generate.sh).
# Paths are relative to app/ where the Python client runs.
FABRIC_TLS_CERT_PATH=../fabric/creds/tls-ca.crt
FABRIC_CERT_PATH=../fabric/creds/admin-cert.pem
FABRIC_PRIVATE_KEY_PATH=../fabric/creds/admin-key.pem

# ── Timeouts (seconds) ──────────────────────────────────────────────────────
FABRIC_EVALUATE_TIMEOUT=30
FABRIC_ENDORSE_TIMEOUT=30
FABRIC_SUBMIT_TIMEOUT=30
FABRIC_COMMIT_TIMEOUT=60
FABRIC_MAX_RETRIES=3

# ── Backend selector ────────────────────────────────────────────────────────
# "fabric"    → FabricLedger (gRPC to peer, requires docker compose up)
# "simulated" → SimulatedLedger (in-memory, no Fabric needed)
LEDGER_BACKEND=fabric
